{
	"name": "potomactech/potomac-mfa",
	"description": "Multi-factor authentication for WordPress sign-in.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Potomac Technologies, LLC",
			"homepage": "https://potomactech.net"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"platform": {
			"php": "8.1.99"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"build": "bin/build-zip.sh"
	}
}
